generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  SUPERVISORS
  YEAR_GROUP
}

enum DataBackupFrequency {
  HOURLY
  DAILY
  WEEKLY
}

enum DataBackupType {
  MANUAL
  AUTOMATED
}

enum DataBackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  role              Role     @default(STUDENT)
  status            AccountStatus @default(ACTIVE)
  sessionVersion    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentProfile    StudentProfile?
  supervisorProfile SupervisorProfile?
  project           Project?

  sentRequests      SupervisionRequest[] @relation("StudentRequests")
  receivedRequests  SupervisionRequest[] @relation("SupervisorRequests")

  assignedStudents  StudentProfile[]     @relation("AssignedSupervisor")

  sentMessages      Message[]            @relation("SentMessages")
  receivedMessages  Message[]            @relation("ReceivedMessages")

  meetingsOrganized Meeting[]            @relation("OrganizerMeetings")
  meetingsAttending Meeting[]            @relation("AttendeeMeetings")

  notifications     Notification[]
  announcementsCreated Announcement[]
  customRoleAssignments UserCustomRole[] @relation("UserCustomRoles")
  customRolesAssigned   UserCustomRole[] @relation("AssignedCustomRoles")
  rolesCreated          CustomRole[]     @relation("RoleCreatedBy")
  incidentsCreated      ServiceIncident[] @relation("IncidentCreatedBy")
  maintenanceCreated    MaintenanceWindow[] @relation("MaintenanceCreatedBy")
  adminImpersonationSessions  ImpersonationSession[] @relation("ImpersonationAdmin")
  targetImpersonationSessions ImpersonationSession[] @relation("ImpersonationTarget")
  actorAuditLogs        AuditLog[]       @relation("ActorAuditLogs")
  targetAuditLogs       AuditLog[]       @relation("TargetAuditLogs")
  matchingBlacklistAsStudent    MatchingBlacklist[] @relation("BlacklistStudent")
  matchingBlacklistAsSupervisor MatchingBlacklist[] @relation("BlacklistSupervisor")
  matchRecommendationsAsStudent MatchRecommendation[] @relation("StudentRecommendations")
  matchRecommendationsAsSupervisor MatchRecommendation[] @relation("SupervisorRecommendations")
  serviceApiKeysCreated ServiceApiKey[]
}

model StudentProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName     String?
  skills       String?
  interests    String?
  onboardingCompleted Boolean @default(true)
  onboardingProjectIdea String?
  onboardingStrengths String?
  onboardingWeaknesses String?
  onboardingConversation Json?
  onboardingSignals Json?

  supervisorId String?
  supervisor   User?   @relation("AssignedSupervisor", fields: [supervisorId], references: [id])
}

model SupervisorProfile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String?
  expertise   String?
  onboardingCompleted Boolean @default(false)
  onboardingConversation Json?
  onboardingSignals Json?
  maxCapacity Int    @default(5)
  acceptingStudents Boolean @default(true)
}

model Project {
  id          String   @id @default(cuid())
  studentId   String   @unique
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicPeriodId String?
  academicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  timelineLocked Boolean @default(false)
  timelineLockedAt DateTime?
  timelineLockReason String?

  title       String?
  description String?
  keywords    String?
  status      String   @default("draft")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests    SupervisionRequest[]
  milestones  Milestone[]
  rescheduleEvents TimelineRescheduleEvent[]
}

model SupervisionRequest {
  id              String   @id @default(cuid())
  studentId       String
  supervisorId    String
  projectId       String?
  academicPeriodId String?
  status          String   @default("pending")
  message         String?
  createdAt       DateTime @default(now())
  respondedAt     DateTime?
  responseMessage String?

  student         User     @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor      User     @relation("SupervisorRequests", fields: [supervisorId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  academicPeriod  AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  @@unique([studentId, supervisorId])
}

model Milestone {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  description    String?
  dueDate        DateTime
  status         String   @default("pending")
  isCriticalPath Boolean  @default(false)
  feedback       String?
  completedDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Meeting {
  id          String   @id @default(cuid())
  organizerId String
  attendeeId  String
  title       String
  description String?
  scheduledAt DateTime
  createdAt   DateTime @default(now())

  organizer   User     @relation("OrganizerMeetings", fields: [organizerId], references: [id], onDelete: Cascade)
  attendee    User     @relation("AttendeeMeetings", fields: [attendeeId], references: [id], onDelete: Cascade)
}

model MatchingConfig {
  id                   String   @id @default("global")
  semanticWeight       Int      @default(40)
  keywordWeight        Int      @default(30)
  capacityWeight       Int      @default(20)
  responseSpeedWeight  Int      @default(10)
  minMatchThreshold    Int      @default(40)
  recommendationCount  Int      @default(5)
  aiExplanationEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RequestOversightConfig {
  id             String   @id @default("global")
  slaDays        Int      @default(7)
  staleExpireDays Int     @default(14)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MatchingBlacklist {
  id           String   @id @default(cuid())
  studentId    String
  supervisorId String
  reason       String?
  createdAt    DateTime @default(now())

  student      User     @relation("BlacklistStudent", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor   User     @relation("BlacklistSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([studentId, supervisorId])
}

model MatchRecommendation {
  id            String   @id @default(cuid())
  studentId     String
  supervisorId  String
  score         Int
  reasons       Json?
  source        String
  generatedAt   DateTime @default(now())

  student       User     @relation("StudentRecommendations", fields: [studentId], references: [id], onDelete: Cascade)
  supervisor    User     @relation("SupervisorRecommendations", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([studentId, supervisorId])
}

model TimelineRescheduleEvent {
  id                String   @id @default(cuid())
  projectId         String
  triggerType       String
  triggeredByUserId String?
  anchorMilestoneId String?
  shiftDaysRequested Int
  shiftDaysApplied   Int
  rescheduledCount   Int
  warnings           Json?
  createdAt          DateTime @default(now())

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AcademicPeriod {
  id                           String   @id @default(cuid())
  name                         String
  startDate                    DateTime
  endDate                      DateTime
  projectEndPolicyAt           DateTime?
  requestSupervisorCutoffAt    DateTime?
  proposalSubmissionCutoffAt   DateTime?
  finalSubmissionAt            DateTime?
  isActive                     Boolean  @default(false)
  isArchived                   Boolean  @default(false)
  archivedAt                   DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  projects                     Project[]
  supervisionRequests          SupervisionRequest[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id                String               @id @default(cuid())
  title             String
  body              String
  severity          AnnouncementSeverity @default(INFO)
  audience          AnnouncementAudience @default(ALL)
  audienceYearGroup String?
  startsAt          DateTime             @default(now())
  expiresAt         DateTime?
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  createdBy         User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?
}

model CustomRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  baseRole    Role?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?    @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  permissions RolePermission[]
  assignments UserCustomRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         CustomRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserCustomRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())

  user         User      @relation("UserCustomRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?      @relation("AssignedCustomRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
}

model ImpersonationSession {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String
  reason       String?
  startedAt    DateTime @default(now())
  endedAt      DateTime?

  admin        User     @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser   User     @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
}

model AuditLog {
  id                    String   @id @default(cuid())
  actorId               String?
  actorEmail            String?
  actorRole             String?
  targetUserId          String?
  action                String
  resource              String?
  resourceId            String?
  metadata              Json?
  impersonationSessionId String?
  createdAt             DateTime @default(now())

  actor                 User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser            User?    @relation("TargetAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
  impersonationSession  ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: SetNull)
}

model ServiceHealthSnapshot {
  id                String   @id @default(cuid())
  serviceKey        String
  serviceName       String
  status            String
  responseMs        Int
  requestPerMin     Int?
  errorRatePercent  Float?
  queueDepth        Int?
  cpuPercent        Float?
  memoryPercent     Float?
  storagePercent    Float?
  dbConnections     Int?
  createdAt         DateTime @default(now())
}

model ServiceIncident {
  id               String   @id @default(cuid())
  serviceKey       String
  title            String
  severity         String
  status           String   @default("open")
  ownerEmail       String?
  description      String?
  resolutionNotes  String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  resolvedAt       DateTime?

  createdBy        User?    @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model MaintenanceWindow {
  id          String   @id @default(cuid())
  title       String
  message     String
  impact      String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?    @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model SystemHealthConfig {
  id                       String   @id @default("global")
  errorRateSpikeThreshold  Float    @default(5.0)
  queueDepthWarning        Int      @default(25)
  queueDepthCritical       Int      @default(60)
  maintenanceBannerLeadMin Int      @default(120)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SystemHealthSignal {
  id                String   @id @default("global")
  apiRequestsLast5m Int      @default(1)
  api5xxLast5m      Int      @default(0)
  aiQueueDepth      Int      @default(0)
  emailQueueDepth   Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model DataManagementConfig {
  id                            String             @id @default("global")
  autoBackupEnabled             Boolean            @default(true)
  backupFrequency               DataBackupFrequency @default(DAILY)
  backupRetentionDays           Int                @default(30)
  piiMaskBackups                Boolean            @default(true)
  completedProjectRetentionDays Int                @default(365)
  messageRetentionDays          Int                @default(365)
  auditLogRetentionDays         Int                @default(730)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
}

model DataBackup {
  id            String           @id @default(cuid())
  type          DataBackupType   @default(MANUAL)
  status        DataBackupStatus @default(COMPLETED)
  format        String           @default("json")
  piiMasked     Boolean          @default(true)
  snapshot      Json?
  recordCount   Int              @default(0)
  sizeBytes     Int              @default(0)
  downloadToken String           @unique
  createdById   String?
  createdByEmail String?
  restoreReason String?
  restoredAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model DataImportJob {
  id             String   @id @default(cuid())
  entityType     String
  status         String   @default("completed")
  processedCount Int      @default(0)
  createdCount   Int      @default(0)
  updatedCount   Int      @default(0)
  failedCount    Int      @default(0)
  errors         Json?
  initiatedById  String?
  initiatedByEmail String?
  createdAt      DateTime @default(now())
}

model PlatformSettings {
  id                        String   @id @default("global")
  institutionName           String   @default("SupervisorMatch")
  institutionLogoUrl        String?
  institutionFaviconUrl     String?
  platformDescription       String?
  supportEmail              String?
  defaultLocale             String   @default("en")
  defaultTimezone           String   @default("Europe/London")
  themeMode                 String   @default("dark")
  featureMessagingEnabled   Boolean  @default(true)
  featureMeetingsEnabled    Boolean  @default(true)
  featureAnnouncementsEnabled Boolean @default(true)
  featureAiExplanationsEnabled Boolean @default(true)
  smtpProvider              String   @default("sendgrid")
  smtpHost                  String?
  smtpPort                  Int?
  smtpUser                  String?
  smtpApiKeyMasked          String?
  aiProvider                String   @default("openai")
  aiModel                   String?
  aiTemperature             Float    @default(0.2)
  aiRateLimitPerMin         Int      @default(60)
  aiApiKeyMasked            String?
  ssoProvider               String?
  ssoEnabled                Boolean  @default(false)
  lmsProvider               String?
  lmsEnabled                Boolean  @default(false)
  calendarProvider          String?
  calendarEnabled           Boolean  @default(false)
  sessionTimeoutMinutes     Int      @default(60)
  passwordMinLength         Int      @default(12)
  twoFactorRequiredForAdmin Boolean  @default(true)
  ipAllowList               String?
  auditLoggingEnabled       Boolean  @default(true)
  loginAttemptLimit         Int      @default(5)
  lockoutMinutes            Int      @default(15)
  updatedById               String?
  updatedByEmail            String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model ServiceApiKey {
  id             String   @id @default(cuid())
  name           String
  service        String
  keyPrefix      String
  keyHash        String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
}
